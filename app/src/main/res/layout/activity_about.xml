<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="About Food Bridge"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@color/green_primary"
        android:padding="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱 Our Mission"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/green_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food Bridge connects people with surplus food to NGOs and volunteers who can redistribute it to those in need, reducing food waste and fighting hunger in local communities."
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 For Donors"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/green_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Post surplus food with details like quantity, category, and pickup location. Track your donations and see who claimed them from your Profile."
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚴 For NGOs &amp; Volunteers"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/green_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browse available donations, filter by category, and tap to claim one for pickup. Rate your experience to help build a trustworthy community."
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Built with Kotlin, Firebase Authentication, and Cloud Firestore."
                android:textSize="12sp"
                android:textColor="#999999" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>